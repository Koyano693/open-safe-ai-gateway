name: Safe-AI Gateway CI/CD Pipeline

on:
  push:
    branches:
      - main
    paths:
      - 'app/**'
      - 'policies/**'
      - 'scripts/**'
      - 'tests/**'
      - 'requirements.txt'
  pull_request:
    branches:
      - main

# OIDCトークン発行およびリポジトリ読み取りに必要な最小権限
permissions:
  id-token: write
  contents: read

jobs:
  # ────────────────────────────────────────────────────────
  # STAGE 1: 自動テスト (Unit / Integration Test)
  # ────────────────────────────────────────────────────────
  test:
    name: Run Automated Tests (pytest)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python 3.10
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Pre-download SentenceTransformer Model
        run: |
          python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

      - name: Run pytest
        run: |
          pytest -v --junitxml=test-results.xml

      - name: Upload Test Results Artifact (Optional)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: test-results.xml

  # ────────────────────────────────────────────────────────
  # STAGE 2: Bedrock Guardrails 自動デプロイ
  # (mainブランチへのマージ かつ テスト成功時のみ実行)
  # ────────────────────────────────────────────────────────
  deploy:
    name: Deploy Policy as Code to AWS Bedrock
    needs: test # ★ テストが成功しない限り絶対に実行されない
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_IAM_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION || 'us-east-1' }}

      - name: Set up Python 3.10
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: 'pip'

      - name: Install Script Dependencies
        run: |
          pip install boto3 pyyaml

      - name: Run Bedrock Guardrails Deploy Script
        run: python scripts/deploy_to_bedrock.py
        env:
          BEDROCK_GUARDRAIL_ID: ${{ secrets.BEDROCK_GUARDRAIL_ID }}
          AWS_REGION: ${{ secrets.AWS_REGION || 'us-east-1' }}
