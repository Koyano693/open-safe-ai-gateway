version: '3.8'

services:
  llm-gateway:
    build: .
    container_name: llm-guard-gateway
    restart: always
    ports:
      - "8080:8080"
    environment:
      - OPENAI_API_KEY=sk-your-real-openai-api-key-here
      - GATEWAY_API_KEY=your-secure-internal-gateway-token
    healthcheck:
      test: ["CMD", "python", "-c", "import requests; requests.get('http://localhost:8080/health')"]
      interval: 30s
      timeout: 10s
      retries: 3
