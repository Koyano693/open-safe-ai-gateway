name: LLM Policy as Code Pipeline

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  lint-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml

      - name: Run Policy Validation Script
        run: python scripts/validate_policy.py

  deploy-policy:
    needs: lint-and-test
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials (例: Amazon Bedrock Guardrailsを使う場合)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: us-east-1

      - name: Deploy Policies to AI Gateway / Cloud Guardrails
        run: |
          echo "Applying new policies to production..."
          # ここでAWS CLIや独自のAPIスクリプトを呼び出し、Bedrock Guardrailsや社内LLM Guardに反映する
          # 例: python scripts/deploy_to_bedrock.py --policy-dir policies/
          echo "Deployment completed successfully."
