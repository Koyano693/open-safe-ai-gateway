from contextlib import asynccontextmanager
from fastapi import FastAPI
from scripts.init_redis_index import init_redis_search_index

@asynccontextmanager
async def lifespan(app: FastAPI):
    # ── 【起動時処理】 Redis インデックスの自動初期化 ──
    print("[SYSTEM] Running startup tasks...")
    init_redis_search_index()
    yield
    # ── 【終了時処理】 ──
    print("[SYSTEM] Shutdown complete.")

app = FastAPI(
    title="Open Safe-AI Gateway with Semantic Cache & Fallback",
    version="2.0.0",
    lifespan=lifespan
)
