# ────────────────────────────────────────────────────────
# 3. Redisフォールバックのテスト (AWS障害時)
# ────────────────────────────────────────────────────────
@patch("app.main.search_semantic_cache")
@patch("app.main.bedrock_client")
def test_secure_rag_redis_fallback(mock_bedrock_client, mock_search_cache):
    """
    AWS側がエラー（例外）を返し、サーキットブレーカー作動後に
    Redisセマンティックキャッシュから代替回答が返されるかをテスト
    """
    # Bedrock側がClientError（障害・スロットリング）を発生させる
    from botocore.exceptions import ClientError
    mock_bedrock_client.converse.side_effect = ClientError(
        {"Error": {"Code": "ThrottlingException", "Message": "Rate exceeded"}},
        "Converse"
    )

    # Redisのセマンティックキャッシュ検索がヒットした場合の戻り値をモック
    mock_search_cache.return_value = "【フォールバック】社内規定によれば、有給の繰越は最大10日までです。"

    # サーキットブレーカーのfail_max回数分エラーを起こしてOpen状態にする
    for _ in range(3):
        client.post(
            "/v1/chat/secure-rag",
            headers=AUTH_HEADERS,
            json={"context": "テスト", "query": "有給の繰越は？"}
        )

    # 4回目のリクエスト（サーキットブレーカーがOpenになり、フォールバックが発動する状態）
    response = client.post(
        "/v1/chat/secure-rag",
        headers=AUTH_HEADERS,
        json={"context": "テスト", "query": "有給の繰越は？"}
    )

    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "fallback_success"
    assert data["source"] == "redis_semantic_cache"
    assert "フォールバック" in data["answer"]
